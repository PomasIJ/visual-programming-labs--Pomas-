    {
        "id": "31a5ad4c5af22630",
        "type": "function",
        "z": "8ba703f6a97b35a3",
        "name": "function 1",
        "func": "let id = msg.req.params.id; // Берем id из URL\n\nif (isNaN(id)) {\n    // Если ввели не число (буквы)\n    msg.statusCode = 400;\n    msg.payload = { \"error\": \"ID must be a number\" };\n} else if (Number(id) > 100) {\n    // Если число больше 100\n    msg.statusCode = 404;\n    msg.payload = { \"error\": \"Item not found\" };\n} else {\n    // Если всё хорошо\n    msg.statusCode = 200;\n    msg.payload = { \"id\": id, \"name\": \"Item #\" + id, \"available\": true };\n}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
